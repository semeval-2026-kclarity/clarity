# NOTE - When adding new variables here, also add fail-fast checks in base_runtime.sh
# Do NOT commit your real .env - this file is an example/template only

# -------------------------------------------------
# Scratch & storage locations (user-specific)
# -------------------------------------------------

# Root scratch directory for this user on CREATE
# Used as the base for all large files and job outputs
SCRATCH_DIR="/scratch/users/[k-number]"

# Directory for model caches (e.g. HuggingFace, torch hub, etc.)
# Should live on scratch to avoid filling $HOME
MODEL_CACHE_DIR="/scratch/users/[k-number]/model_cache"

# Directory for masking caches
# Should live on scratch to avoid filling $HOME
MASKING_CACHE_DIR="/scratch/users/[k-number]/masking_cache"

# Directory where experiment outputs, logs, and predictions are written
# This should persist across jobs
MODEL_OUTPUTS_DIR="/scratch/users/[k-number]/model_outputs"

# -------------------------------------------------
# Conda / Python environment configuration
# -------------------------------------------------

# Absolute path to the conda environment used for all experiments
# This environment is activated by base_runtime.sh
CONDA_ENV_DIR="/scratch/users/[k-number]/conda/semeval-env"

# Base directory of the conda installation (e.g. Miniforge)
# Used to initialise conda on compute nodes
CONDA_BASE_DIR="/scratch/users/[k-number]/miniforge3"

# -------------------------------------------------
# Weights & Biases (W&B) configuration
# -------------------------------------------------

# W&B entity (user or team name)
WANDB_ENTITY="[team-name]"

# W&B project name under the above entity
WANDB_PROJECT="[project-name]"

# Personal W&B API key (keep this private)
WANDB_API_KEY="[api-key]"

# -------------------------------------------------
# Huggingface API token
# -------------------------------------------------

HF_API_KEY="[hg-api-key]"

# -------------------------------------------------
# Open AI secret key
# -------------------------------------------------

OPENAI_API_KEY="[openai-secret-key]"